# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# Backend API base URL.
VITE_API_BASE_URL=https://backend-production-c0d92.up.railway.app/
#
# If you're running the Django backend locally instead, use:
# VITE_API_BASE_URL=http://localhost:8000

# Google Sign-In (same Client ID as backend GOOGLE_CLIENT_ID — this one is public,
# safe to expose in the frontend bundle; get it from Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID -> Application type: Web application)
VITE_GOOGLE_CLIENT_ID=
