# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# Backend API base URL. Leave unset in local dev — client.js auto-infers
# http://localhost:8000 when the frontend runs on a different port.
# VITE_API_BASE_URL=http://localhost:8000

# Google Sign-In (same Client ID as backend GOOGLE_CLIENT_ID — this one is public,
# safe to expose in the frontend bundle; get it from Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID -> Application type: Web application)
VITE_GOOGLE_CLIENT_ID=
